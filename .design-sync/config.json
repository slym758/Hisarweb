{
    "pkg": "hisar-ui",
    "globalName": "HisarUI",
    "shape": "package",
    "projectId": "57c8a6a5-df65-434b-ba10-db35d9c4a42f",
    "entry": "./.design-sync/entry.ts",
    "srcDir": "resources/js/components/ui",
    "tsconfig": "./tsconfig.json",
    "cssEntry": ".design-sync/compiled/app.css",
    "buildCmd": "npx --yes @tailwindcss/cli@4 -i resources/css/app.css -o .design-sync/compiled/app.css",
    "runtimeFontPrefixes": ["Inter"],
    "readmeHeader": ".design-sync/conventions.md",
    "overrides": {
        "Dialog": { "cardMode": "single", "viewport": "680x440" },
        "Sheet": { "cardMode": "single", "viewport": "760x480" },
        "DropdownMenu": { "cardMode": "single", "viewport": "440x340" },
        "Popover": { "cardMode": "single", "viewport": "440x400" },
        "Tooltip": { "cardMode": "single", "viewport": "440x220" },
        "Sidebar": { "cardMode": "single", "viewport": "840x460" }
    },
    "componentSrcMap": {
        "Accordion": "resources/js/components/ui/accordion.tsx",
        "Alert": "resources/js/components/ui/alert.tsx",
        "Avatar": "resources/js/components/ui/avatar.tsx",
        "Badge": "resources/js/components/ui/badge.tsx",
        "Breadcrumb": "resources/js/components/ui/breadcrumb.tsx",
        "Button": "resources/js/components/ui/button.tsx",
        "Card": "resources/js/components/ui/card.tsx",
        "Checkbox": "resources/js/components/ui/checkbox.tsx",
        "Collapsible": "resources/js/components/ui/collapsible.tsx",
        "Dialog": "resources/js/components/ui/dialog.tsx",
        "DropdownMenu": "resources/js/components/ui/dropdown-menu.tsx",
        "Form": "resources/js/components/ui/form.tsx",
        "Input": "resources/js/components/ui/input.tsx",
        "Label": "resources/js/components/ui/label.tsx",
        "NavigationMenu": "resources/js/components/ui/navigation-menu.tsx",
        "Pagination": "resources/js/components/ui/pagination.tsx",
        "Popover": "resources/js/components/ui/popover.tsx",
        "RadioGroup": "resources/js/components/ui/radio-group.tsx",
        "ScrollArea": "resources/js/components/ui/scroll-area.tsx",
        "Select": "resources/js/components/ui/select.tsx",
        "Separator": "resources/js/components/ui/separator.tsx",
        "Sheet": "resources/js/components/ui/sheet.tsx",
        "Sidebar": "resources/js/components/ui/sidebar.tsx",
        "Skeleton": "resources/js/components/ui/skeleton.tsx",
        "Switch": "resources/js/components/ui/switch.tsx",
        "Table": "resources/js/components/ui/table.tsx",
        "Tabs": "resources/js/components/ui/tabs.tsx",
        "Textarea": "resources/js/components/ui/textarea.tsx",
        "Toaster": "resources/js/components/ui/sonner.tsx",
        "Toggle": "resources/js/components/ui/toggle.tsx",
        "ToggleGroup": "resources/js/components/ui/toggle-group.tsx",
        "Tooltip": "resources/js/components/ui/tooltip.tsx"
    }
